# .env.example
# Copie este arquivo para .env e preencha com seus valores

# Token do Bot (OBRIGATÓRIO)
# Obtenha com @BotFather no Telegram
NURGLE_BOT_TOKEN=seu_token_aqui

# ID do Administrador (OPCIONAL)
# Seu user ID do Telegram para comandos administrativos
# Para descobrir seu ID, use @userinfobot no Telegram
ADMIN_TELEGRAM_ID=123456789

# Nível de Log (OPCIONAL)
# Opções: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Configurações de Webhook (OPCIONAL - apenas se usar webhook)
# WEBHOOK_URL=https://seu-dominio.com/webhook
# PORT=8443

# Configurações do Sistema de Infecção (OPCIONAL)
# DAILY_BLESSING_COOLDOWN=86400
# MAX_LEVEL=15
# STREAK_BONUS_MULTIPLIER=1.5

# Configurações de Rate Limiting (OPCIONAL)
# COMMANDS_PER_MINUTE=20
# TRIVIA_COOLDOWN=30
